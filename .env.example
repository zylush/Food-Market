# FOODIESFEED LOCAL SETUP (safe to copy; this file contains no real secrets)
#
# You normally do not need to change anything for a first preview.
# 1. Open a terminal in this project folder and create your private copy:
#    Windows PowerShell: `Copy-Item .env.example apps/api/.env`
#    macOS/Linux Terminal: `cp .env.example apps/api/.env`
# 2. Edit ONLY `apps/api/.env` on your own computer. Do not share or commit it.
# 3. In that same terminal, run `corepack pnpm dev`, then open http://localhost:3000.
#    Keep the terminal open while using the site; press Ctrl+C there to stop it later.
#
# For a first local preview, leave the optional MySQL and Stripe values blank.
# Search still works with temporary local-only data; recent searches and billing need
# the fuller MySQL/Stripe walkthrough in README.md.

# Keep these values for a normal localhost preview. Change PORT only if 4000 is busy.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# OPTIONAL: local MySQL for saved recent searches and database testing.
# Leave all three blank for the first local preview. When ready, follow README.md's
# “Create isolated local databases” section and paste your own local connection URLs.
DATABASE_URL=
TEST_DATABASE_URL=
SHADOW_DATABASE_URL=

# A private local-only phrase used to sign the demo session. Make it 32+ characters.
# This is not a password for your food account, and it must be different on Vercel.
SESSION_SECRET=replace-with-a-private-local-secret-of-at-least-32-characters
DEMO_USER_EMAIL=demo@foodiesfeed.local

# OPTIONAL: Stripe test mode is only needed for the billing walkthrough in README.md.
# Leave these blank for regular local searching. Never use real/live Stripe keys here.
# Never rename these with NEXT_PUBLIC_; browsers must never receive them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Leave as 0. It matters only for Vercel's Stripe webhook handling and is harmless locally.
NODEJS_HELPERS=0

# Product search works without an API key. Leave the URL as shown.
# Before making live searches, replace your-email@example.com with a contact email you control.
# This is sent to Open Food Facts as identification; it is not a password.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=FoodiesFeed/0.1 (your-email@example.com)
