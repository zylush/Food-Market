NODE_ENV=development
PORT=4000

# Local MySQL databases: foodiesfeed_dev, foodiesfeed_test, foodiesfeed_shadow
DATABASE_URL=mysql://foodiesfeed:change-me@127.0.0.1:3306/foodiesfeed_dev
TEST_DATABASE_URL=mysql://foodiesfeed:change-me@127.0.0.1:3306/foodiesfeed_test
SHADOW_DATABASE_URL=mysql://foodiesfeed:change-me@127.0.0.1:3306/foodiesfeed_shadow

SESSION_SECRET=replace-with-a-local-secret-at-least-32-characters
DEMO_USER_EMAIL=demo@foodiesfeed.local

APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Server-only Stripe test-mode values. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=FoodiesFeed/0.1 (demo@example.invalid)
