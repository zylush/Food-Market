{
  "name": "foodiesfeed",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @foodiesfeed/api --filter @foodiesfeed/web dev",
    "build": "pnpm --filter @foodiesfeed/contracts build && pnpm --filter @foodiesfeed/api build && pnpm --filter @foodiesfeed/web build",
    "typecheck": "pnpm --filter @foodiesfeed/contracts typecheck && pnpm --filter @foodiesfeed/api typecheck && pnpm --filter @foodiesfeed/web typecheck",
    "lint": "pnpm --filter @foodiesfeed/contracts lint && pnpm --filter @foodiesfeed/api lint && pnpm --filter @foodiesfeed/web lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @foodiesfeed/api prisma:generate",
    "db:migrate": "pnpm --filter @foodiesfeed/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @foodiesfeed/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @foodiesfeed/api prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
